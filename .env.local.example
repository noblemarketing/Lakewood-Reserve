# Copy to `.env` for local `netlify dev`, or set in Netlify Site settings → Environment variables.
# Use placeholder values only in this file — never commit real keys.

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
# Optional: only if you keep a Stripe webhook endpoint configured
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret_here

# Paddle board shed code at The Apex (never expose to the browser)
SHED_CODE=your_shed_code_here

# Kayak lock code at Anchor Twenty Eight — separate storage area (never expose to the browser)
# Key: KAYAK_LOCK_CODE (or KAYAKKEYCODE)
KAYAK_LOCK_CODE=your_kayak_lock_code_here

# Public site URL, no trailing slash (used for Stripe success/cancel redirects)
# Local netlify dev only: http://localhost:8888
# Netlify production: https://your-site.netlify.app (do not use localhost on Netlify)
SITE_URL=http://localhost:8888

# Rental prices: edit netlify/functions/lib/rental-config.js (amounts in cents)
